#DEPS(mk.deps) sdl2(native psysroot): unselect featurecfg

# fix "error: bits/sys_errlist.h: No such file or directory": sudo apt install gcc-multilib g++-multilib

PACKAGE_NAME     = sdl2

LICENSE          = zlib
LICFILE          = file://LICENSE.txt
HOMEPAGE         = http://www.libsdl.org
DESCRIPTION      = Simple DirectMedia Layer is a cross-platform development library designed to provide low level access \
                   to audio, keyboard, mouse, joystick, and graphics hardware via OpenGL and Direct3D. It is used by video \
                   playback software, emulators, and popular games including Valve's award winning catalog and many Humble \
                   Bundle games.

-include $(ENV_CFG_ROOT)/.config
include $(ENV_MAKE_DIR)/inc.env.mk

VERSION          = 2.32.8
SRC_DIR          = SDL2-$(VERSION)
SRC_NAME         = $(SRC_DIR).tar.gz
SRC_URL          = https://github.com/libsdl-org/SDL/releases/download/release-$(VERSION)/$(SRC_NAME)
SRC_MD5          = 7df28be966308a4a51aac87f4e0cf16a

CACHE_BUILD      = y
CACHE_DEPENDS    =

COMPILE_TOOL     = cmake
CMAKE_FLAGS     += -DCMAKE_REQUIRED_LINK_OPTIONS="$(shell echo $(call link_libs) | sed 's/ /;/g')"

$(eval $(call ft-config,CONFIG_SDL2_FT_ALSA,-DSDL_ALSA=ON,-DSDL_ALSA=OFF,alsa-lib selected))
$(eval $(call ft-config,CONFIG_SDL2_FT_DIRECTFB,-DSDL_DIRECTFB=ON,-DSDL_DIRECTFB=OFF,directfb))
$(eval $(call ft-config,CONFIG_SDL2_FT_OPENGL,-DSDL_OPENGL=ON -DSDL_OPENGLES=ON,-DSDL_OPENGL=OFF -DSDL_OPENGLES=OFF,mesa selected))
$(eval $(call ft-config,CONFIG_SDL2_FT_JACK,-DSDL_JACK=ON,-DSDL_JACK=OFF,jack))
$(eval $(call ft-config,CONFIG_SDL2_FT_KMSDRM,-DSDL_KMSDRM=ON,-DSDL_KMSDRM=OFF,libdrm selected,CONFIG_SDL2_FT_OPENGL))
$(eval $(call ft-config,CONFIG_SDL2_FT_PULSEAUDIO,-DSDL_PULSEAUDIO=ON,-DSDL_PULSEAUDIO=OFF,pulseaudio selected))
$(eval $(call ft-config,CONFIG_SDL2_FT_VULKAN,-DSDL_VULKAN=ON,-DSDL_VULKAN=OFF,,CONFIG_SDL2_FT_OPENGL))
$(eval $(call ft-config,CONFIG_SDL2_FT_WAYLAND,-DSDL_WAYLAND=ON,-DSDL_WAYLAND=OFF,wayland libxkbcommon))
$(eval $(call ft-config,CONFIG_SDL2_FT_X11,-DSDL_X11=ON,-DSDL_X11=OFF,libx11 libxext libxrandr libxrender))

include $(ENV_MAKE_DIR)/inc.rule.mk
