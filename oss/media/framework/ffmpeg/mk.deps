#DEPS(mk.deps) ffmpeg(native psysroot): unselect featurecfg

PACKAGE_NAME     = ffmpeg

LICENSE          = GPL-2.0-or-later & LGPL-2.1-or-later & ISC & MIT & BSD-2-Clause & BSD-3-Clause & IJG
LICFILE          = file://COPYING*
HOMEPAGE         = https://www.ffmpeg.org/
DESCRIPTION      = FFmpeg is the leading multimedia framework, able to decode, encode, transcode, mux, demux, stream, \
                   filter and play pretty much anything that humans and machines have created. It supports the most \
                   obscure ancient formats up to the cutting edge.

-include $(ENV_CFG_ROOT)/.config
include $(ENV_MAKE_DIR)/inc.env.mk

VERSION          = 9.0.2
SRC_DIR          = $(PACKAGE_NAME)-$(VERSION)
SRC_NAME         = $(SRC_DIR).tar.xz
SRC_URL          = https://ffmpeg.org/releases/$(SRC_NAME)
SRC_MD5          = 4c47fa111bd791da246ec07748ba5e04

CACHE_BUILD      = y
CACHE_DEPENDS    =

AUTOTOOLS_FLAGS += --enable-pic --enable-pthreads --enable-shared
AUTOTOOLS_FLAGS += --disable-mipsdsp --disable-mipsdspr2 --disable-asm
AUTOTOOLS_FLAGS += --pkg-config=pkg-config
AUTOTOOLS_FLAGS += --extra-cflags="$(call link_hdrs)" --extra-ldflags="$(call link_libs)"
INS_CONFIG      ?= --prefix=$(INS_TOPDIR)$(INS_SUBDIR)

# libraries to build in addition to avutil
$(eval $(call ft-config,CONFIG_FFMPEG_EN_AVDEVICE,--enable-avdevice,--disable-avdevice,selected))
$(eval $(call ft-config,CONFIG_FFMPEG_EN_AVFILTER,--enable-avfilter,--disable-avfilter,selected))
$(eval $(call ft-config,CONFIG_FFMPEG_EN_AVCODEC,--enable-avcodec,--disable-avcodec,selected))
$(eval $(call ft-config,CONFIG_FFMPEG_EN_AVFORMAT,--enable-avformat,--disable-avformat,selected))
$(eval $(call ft-config,CONFIG_FFMPEG_EN_SWRESAMPLE,--enable-swresample,--disable-swresample,selected))
$(eval $(call ft-config,CONFIG_FFMPEG_EN_SWSCALE,--enable-swscale,--disable-swscale,selected))
#$(eval $(call ft-config,CONFIG_FFMPEG_EN_POSTPROC,--enable-postproc,--disable-postproc,selected))

# features to support
$(eval $(call ft-config,CONFIG_FFMPEG_FT_ALSA,--enable-alsa,--disable-alsa,alsa-lib selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_ALTIVEC,--enable-altivec,--disable-altivec))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_BZLIB,--enable-bzlib,--disable-bzlib,bzip2 selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_FDK_AAC,--enable-libfdk-aac --enable-nonfree,--disable-libfdk-aac,fdk-aac selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_GPL,--enable-gpl,--disable-gpl selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_GSM,--enable-libgsm,--disable-libgsm,libgsm))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_JACK,--enable-indev=jack,--disable-indev=jack,jack))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_LIBOPUS,--enable-libopus,--disable-libopus,opus selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_LIBVORBIS,--enable-libvorbis,--disable-libvorbis,libvorbis selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_LZMA,--enable-lzma,--disable-lzma,xz selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_MFX,--enable-libmfx,--disable-libmfx,intel-mediasdk))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_MP3LAME,--enable-libmp3lame,--disable-libmp3lame,lame))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_OPENSSL,--enable-openssl --enable-version3,--disable-openssl,openssl selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_SDL2,--enable-sdl2,--disable-sdl2,sdl2 selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_SPEEX,--enable-libspeex,--disable-libspeex,speex))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_SRT,--enable-libsrt,--disable-libsrt,srt selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_THEORA,--enable-libtheora,--disable-libtheora,libtheora libogg))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_VAAPI,--enable-vaapi,--disable-vaapi,libva))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_VDPAU,--enable-vdpau,--disable-vdpau,libvdpau))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_VPX,--enable-libvpx,--disable-libvpx,libvpx))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_X264,--enable-libx264,--disable-libx264,x264 selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_X265,--enable-libx265,--disable-libx265,x265 selected))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_XCB,--enable-libxcb,--disable-libxcb,libxcb))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_XV,--enable-outdev=xv,--disable-outdev=xv,libxv))
$(eval $(call ft-config,CONFIG_FFMPEG_FT_ZLIB,--enable-zlib,--disable-zlib,zlib selected))

CUSTOM_TARGETS   = compile
include $(ENV_MAKE_DIR)/inc.rule.mk

compile:
	$(PREAT)sed -i 's@NULL, x265pic_lyrptr_out)@NULL, x265pic_lyrptr_out[i])@g' $(SRC_PATH)/libavcodec/libx265.c
	$(PREAT)cd $(OBJ_PREFIX) && \
		$(SRC_PATH)/configure $(if $(CROSS_COMPILE),--enable-cross-compile --cross-prefix=$(CROSS_COMPILE) \
				--arch=$(shell $(MACHINE_SCRIPT) arch) --target-os=linux) \
			$(INS_CONFIG) $(AUTOTOOLS_FLAGS) $(FT_CONFIG) $(TOLOG) && \
		$(MAKE) $(MAKE_FLAGS) $(TOLOG) && $(MAKE) $(MAKE_FLAGS) install $(TOLOG)

