#DEPS(mk.deps) xvidcore(native psysroot): unselect

PACKAGE_NAME     = xvidcore

LICENSE          = GPL-2.0-only
LICPATH          = $(WORKDIR)/$(SRC_DIR)
LICFILE          = file://LICENSE
HOMEPAGE         = https://labs.xvid.com/
DESCRIPTION      = Xvid Codec – the MPEG4 video codec built by the open-source community.

include $(ENV_MAKE_DIR)/inc.env.mk

VERSION          = 1.3.7
SRC_DIR          = $(PACKAGE_NAME)
SRC_NAME         = $(PACKAGE_NAME)-$(VERSION).tar.gz
SRC_URL          = https://downloads.xvid.com/downloads/$(SRC_NAME)
SRC_MD5          = 5c6c19324608ac491485dbb27d4da517
SRC_PATH         = $(WORKDIR)/$(SRC_DIR)/build/generic
OBJ_PREFIX       = $(SRC_PATH)

CACHE_BUILD      = y
CACHE_DEPENDS    = none

COMPILE_TOOL     = autotools

CUSTOM_TARGETS   = prepend
include $(ENV_MAKE_DIR)/inc.rule.mk

prepend:
	$(PREAT)sed -i 's/typedef int bool;/#include <stdbool.h>/g' $(WORKDIR)/$(SRC_DIR)/src/encoder.h

