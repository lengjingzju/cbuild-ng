From 110d227a0e9bf95739028bf886cc9683b9b272c3 Mon Sep 17 00:00:00 2001
From: Jing Leng <3090101217@zju.edu.cn>
Date: Wed, 11 Nov 2026 13:39:55 +0800
Subject: [PATCH] zltoolkit: add installation rules

---
 CMakeLists.txt | 34 +++++++++++++++++++++++++++++-----
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 13ce84b..93c5fe3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -140,9 +140,33 @@ set_target_properties(${PROJECT_NAME} PROPERTIES LIBRARY_OUTPUT_DIRECTORY ${PROJ
                                                  ARCHIVE_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/lib)
 
 if (CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
-    #本工程为root工程，则添加测试程序，并启用ctest以便执行门禁用例
-    #This project is the root project, add the test programs and enable ctest so that
-    #the gating cases can be run
-    enable_testing()
+    #本工程为root工程，则默认添加测试程序
+    set(default_BUILD_TESTS ON)
+else()
+    set(default_BUILD_TESTS OFF)
+endif()
+option(BUILD_TESTS "Build test programs" ${default_BUILD_TESTS})
+if (BUILD_TESTS)
     add_subdirectory(tests)
-endif ()
\ No newline at end of file
+endif ()
+
+# -----------------------------------------------------------------------------
+# 安装规则
+# -----------------------------------------------------------------------------
+install(TARGETS ${PROJECT_NAME}
+    EXPORT ${PROJECT_NAME}Targets
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+    INCLUDES DESTINATION include)
+
+# 安装头文件（保留 src 下的目录层次）
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/src/
+    DESTINATION include/${PROJECT_NAME}
+    FILES_MATCHING
+    PATTERN "*.h"
+    PATTERN "*.hpp"
+    PATTERN "*.mm"
+    PATTERN "*/.*" EXCLUDE
+)
+
-- 
2.47.3

