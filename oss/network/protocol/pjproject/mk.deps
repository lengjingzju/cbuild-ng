#DEPS(mk.deps) pjproject(native psysroot): unselect

PACKAGE_NAME     = pjproject

LICENSE          = GPL-2.0
LICFILE          = file://COPYING
HOMEPAGE         = https://github.com/pjsip/pjproject
DESCRIPTION      = PJSIP is a free and open source multimedia communication library written in C with high level API in C, \
                   C++, Java, C#, and Python languages. It implements standard based protocols such as SIP, SDP, RTP, STUN, \
                   TURN, and ICE. It combines signaling protocol (SIP) with rich multimedia framework and NAT traversal \
                   functionality into high level API that is portable and suitable for almost any type of systems ranging \
                   from desktops, embedded systems, to mobile handsets.

include $(ENV_MAKE_DIR)/inc.env.mk

VERSION          = 2.17
SRC_DIR          = $(PACKAGE_NAME)-$(VERSION)
SRC_NAME         = $(SRC_DIR).tar.gz
SRC_URL          = https://github.com/pjsip/pjproject/archive/refs/tags/$(VERSION).tar.gz
SRC_MD5          = 9ad9b91b8b99ef476ad443a7b786bf6f
OBJ_PREFIX       = $(SRC_PATH)

CACHE_BUILD      = y
CACHE_DEPENDS    = none

COMPILE_TOOL     = autotools
AUTOTOOLS_FLAGS  = --enable-shared          \
                   --disable-upnp           \
                   --disable-resample       \
                   --disable-sound          \
                   --disable-video          \
                   --disable-ext-sound      \
                   --disable-speex-aec      \
                   --disable-g711-codec     \
                   --disable-l16-codec      \
                   --disable-gsm-codec      \
                   --disable-g722-codec     \
                   --disable-g7221-codec    \
                   --disable-speex-codec    \
                   --disable-ilbc-codec     \
                   --disable-libsamplerate  \
                   --enable-resample-dll    \
                   --disable-speex-resample \
                   --disable-sdl            \
                   --disable-ffmpeg         \
                   --disable-v4l2           \
                   --disable-openh264       \
                   --disable-vpx            \
                   --disable-ipp            \
                   --disable-ssl            \
                   --disable-silk           \
                   --disable-opus           \
                   --disable-bcg729         \
                   --disable-lyra           \
                   --disable-libsrtp        \
                   --disable-libyuv         \
                   --disable-libwebrtc      \
                   --disable-libwebrtc-aec3


export LD       := $(CXX)

CUSTOM_TARGETS   = prepend
include $(ENV_MAKE_DIR)/inc.rule.mk

prepend:
	$(PREAT)sed -i 's@./aconfigure@\$$(dirname \$$0)/aconfigure@g' $(SRC_PATH)/configure
	$(PREAT)sed -i 's@armv7l@arm@g' $(SRC_PATH)/aconfigure
