#DEPS(mk.deps) linux(menuconfig defconfig %_defconfig): unselect KERNEL_SRC!=

PACKAGE_NAME     = linux

LICENSE          = GPL-2.0-only
HOMEPAGE         = https://www.kernel.org/
DESCRIPTION      = Linux is a clone of the operating system Unix, written from scratch by Linus Torvalds with assistance \
                   from a loosely-knit team of hackers across the Net. It aims towards POSIX and Single UNIX Specification \
                   compliance. \
                   It has all the features you would expect in a modern fully-fledged Unix, including true multitasking, \
                   virtual memory, shared libraries, demand loading, shared copy-on-write executables, proper memory \
                   management, and multistack networking including IPv4 and IPv6. \
                   Although originally developed first for 32-bit x86-based PCs (386 or higher), today Linux also runs on \
                   a multitude of other processor architectures, in both 32- and 64-bit variants.

VERSION          = $(shell $(MACHINE_SCRIPT) linux_version)
SRC_DDIR         = $(shell dirname $(KERNEL_SRC))
SRC_DIR          = $(PACKAGE_NAME)-$(VERSION)
SRC_NAME         = $(SRC_DIR).tar.xz
SRC_URL          = https://www.kernel.org/pub/linux/kernel/v$(shell echo $(VERSION) | cut -d '.' -f 1).x/$(SRC_NAME)
SRC_MD5          = $(shell $(MACHINE_SCRIPT) linux_srchash)

-include $(ENV_CFG_ROOT)/.config
include $(ENV_MAKE_DIR)/inc.env.mk

LINUX_CONFIG    := $(shell echo $(CONFIG_LINUX_CONFIG))
LINUX_CFGDIR    := $(ENV_TOP_DIR)/board/$(ENV_BUILD_SOC)/linux-configs
MAKE_FLAGS      := $(ENV_BUILD_JOBS) -C $(KERNEL_SRC) O=$(KERNEL_OUT) INSTALL_MOD_PATH=$(INS_PREFIX)

CUSTOM_TARGETS   = compile install clean
include $(ENV_MAKE_DIR)/inc.rule.mk

.PHONY: loadconfig defconfig menuconfig

loadconfig:
ifeq ($(LINUX_CONFIG), )
	$(PREAT)mkdir -p $(KERNEL_OUT)
	$(PREAT)$(MAKE) $(MAKE_FLAGS) defconfig
else
	$(PREAT)mkdir -p $(KERNEL_OUT)
	$(PREAT)if [ -f $(LINUX_CFGDIR)/$(LINUX_CONFIG) ]; then \
		echo "Loading '$(LINUX_CFGDIR)/$(LINUX_CONFIG)' as linux config"; \
		cp -f $(LINUX_CFGDIR)/$(LINUX_CONFIG) $(KERNEL_OUT)/.config; \
	else \
		echo "loaLoadingd '$(LINUX_CONFIG)' as linux config"; \
		$(MAKE) $(MAKE_FLAGS) $(LINUX_CONFIG); \
	fi
endif

defconfig:
	$(PREAT)$(call do_fetch)
	$(PREAT)$(MAKE) -f $(MAKE_FNAME) loadconfig

menuconfig:
	$(PREAT)$(call do_fetch)
	$(PREAT)if [ ! -f $(KERNEL_OUT)/.config ]; then \
		$(MAKE) -f $(MAKE_FNAME) loadconfig; \
	fi
	$(PREAT)$(MAKE) $(MAKE_FLAGS) menuconfig

%_defconfig:
	$(PREAT)$(call do_fetch)
	$(PREAT)mkdir -p $(KERNEL_OUT)
	$(PREAT)if [ -f $(LINUX_CFGDIR)/$@ ]; then \
		echo "Loading '$(LINUX_CFGDIR)/$@' as linux config"; \
		cp -f $(LINUX_CFGDIR)/$@ $(KERNEL_OUT)/.config; \
	else \
		echo "Loading '$@' as linux config"; \
		$$(MAKE) (MAKE_FLAGS) $@; \
	fi

compile:
	$(PREAT)if [ ! -f $(KERNEL_OUT)/.config ]; then \
		$(MAKE) -f $(MAKE_FNAME) loadconfig; \
	fi
	$(PREAT)echo "Compiling linux-$(KERNEL_VER) to $(KERNEL_OUT) ..."
	$(PREAT)$(MAKE) $(MAKE_FLAGS) all $(TOLOG)
	$(PREAT)echo "Build $(PACKAGE_NAME) Done."

install:
	$(PREAT)echo "Install linux-$(KERNEL_VER) to $(INS_PREFIX) ..."
	$(PREAT)mkdir -p $(INS_PREFIX)/boot
	$(PREAT)cp -dfp $(KERNEL_OUT)/arch/$(KERNEL_ARCH)/boot/*Image* $(INS_PREFIX)/boot
	$(PREAT)$(MAKE) $(MAKE_FLAGS) modules_install $(TOLOG)
	$(PREAT)echo "Install $(PACKAGE_NAME) Done."
clean:
	$(PREAT)if [ -e $(KERNEL_SRC) ]; then \
		$(MAKE) $(MAKE_FLAGS) clean $(TOLOG); \
		$(MAKE) $(MAKE_FLAGS) mrproper $(TOLOG); \
	fi
	$(PREAT)echo "Clean $(PACKAGE_NAME) Done."
